# ============================================
# Local Development Configuration
# ============================================
ENVIRONMENT=local

# Twilio credentials (developer-provided, users don't need anything)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret
TWILIO_FROM_NUMBER=+15555550100

# ============================================
# Gumstack Configuration (set by gumstack in production)
# ============================================
GUMSTACK_SERVER_ID=twilio-sms
# GUMSTACK_BACKEND_URL=https://api.gumstack.com
# GUMLOOP_BACKEND_URL=https://api.gumloop.com
